{
	"name": "${localWorkspaceFolderBasename}",
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile",
		"args": {
			"WORKSPACE_FOLDER_BASENAME": "${localWorkspaceFolderBasename}"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {},
			"extensions": [
				"ms-azuretools.vscode-docker",
				"JuanBlanco.solidity"
			]
		}
	},
	"initializeCommand": "bash .devcontainer/create-empty-files.sh ../.${localWorkspaceFolderBasename}",
	"runArgs": [
		"--env-file",
		"../.${localWorkspaceFolderBasename}/.env"
	],
	"mounts": [
		"type=volume,target=/workspaces/${localWorkspaceFolderBasename}/node_modules",
		"type=bind,source=${localWorkspaceFolder}/../.${localWorkspaceFolderBasename}/.bash_history,target=/commandhistory/.bash_history"
	],
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}
